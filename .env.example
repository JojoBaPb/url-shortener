# Copy this file to .env and change the values. Never commit your real .env.

# Local development (no install needed): a SQLite file next to the code.
DATABASE_URL=sqlite+aiosqlite:///./shortener.db

# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener

# Print every SQL query (debugging only).
SQL_ECHO=false
